<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ApplicationId>io.github.divadiow.tuyadumpjson</ApplicationId>
    <ApplicationTitle>Tuya Dump JSON</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <RuntimeIdentifiers>android-arm;android-arm64;android-x86;android-x64</RuntimeIdentifiers>
    <AndroidManifest>AndroidManifest.xml</AndroidManifest>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <AndroidUseAapt2>true</AndroidUseAapt2>
    <AndroidLinkMode>SdkOnly</AndroidLinkMode>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Deterministic>true</Deterministic>
    <NoWarn>$(NoWarn);CA1416;CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TuyaConfig.Core\TuyaConfig.Core.csproj" />
  </ItemGroup>
</Project>
